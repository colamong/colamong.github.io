---
import { KIND_LABEL } from '../content.config';

interface Props {
  posts: any[];
}
const { posts } = Astro.props;

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

/** 긴 글은 대부분이라 「긴 글」 배지가 구분이 안 된다 — 읽는 시간을 대신 보인다 (BLOG-ADR-002). */
const CHARS_PER_MINUTE = 500;
const readingMinutes = (body: string = '') => {
  const text = body.replace(/<svg\b[\s\S]*?<\/svg>/g, '').replace(/<[^>]+>/g, '');
  return Math.max(1, Math.round(text.replace(/\s+/g, '').length / CHARS_PER_MINUTE));
};
const badgeOf = (p: any) =>
  p.data.kind === 'long' ? `${readingMinutes(p.body)}분` : KIND_LABEL[p.data.kind];
---

<ul class="list">
  {
    posts.map((p) => {
      const external = p.data.kind === 'link' && p.data.href;
      const href = external ? p.data.href : `/posts/${p.id}/`;
      return (
        <li class="row">
          <a
            class="row__link"
            href={href}
            {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <span class="row__top">
              <span class="row__title">{p.data.title}</span>
              <span class="badge">{badgeOf(p)}</span>
              <span class="row__date">{fmt(p.data.date)}</span>
            </span>
          </a>
          <span class="row__blurb">{p.data.blurb}</span>
        </li>
      );
    })
  }
</ul>
